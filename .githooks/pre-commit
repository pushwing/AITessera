#!/usr/bin/env bash
#
# pre-commit 훅 — 스테이징된 *.php 를 PHP-CS-Fixer 로 자동 정렬 후 재-스테이징한다.
# 커밋을 막지는 않는다(스타일 위반은 여기서 자동 교정되고, PHPStan·PHPUnit 은 pre-push 에서 검증).
#
# 주의: git add -p 로 부분 스테이징한 상태에서는 이 훅이 파일 전체(스테이징하지 않은
#       변경 포함)를 대상으로 CS-Fixer 를 돌리므로, 의도치 않은 변경까지 커밋에 섞일 수 있다.
#       그런 경우엔 SKIP_HOOKS=1 을 쓴다.
#
# 긴급 우회: SKIP_HOOKS=1 git commit ...

set -euo pipefail

if [ "${SKIP_HOOKS:-0}" = "1" ]; then
    echo "⚠ pre-commit: SKIP_HOOKS=1 — CS-Fixer 자동 정렬을 건너뜁니다."
    exit 0
fi

cd "$(git rev-parse --show-toplevel)"

staged_php="$(git diff --cached --name-only --diff-filter=ACMR -- '*.php')"

if [ -z "$staged_php" ]; then
    exit 0
fi

if ! command -v composer >/dev/null 2>&1; then
    echo "⚠ pre-commit: composer 를 찾을 수 없어 CS-Fixer 를 건너뜁니다."
    exit 0
fi

echo "▶ pre-commit: PHP-CS-Fixer 자동 정렬 중…"

# shellcheck disable=SC2086
composer cs-fix -- $staged_php || true

# shellcheck disable=SC2086
git add $staged_php

echo "✔ pre-commit: 스타일 정렬 완료 — 재-스테이징됨"
